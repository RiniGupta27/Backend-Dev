# Environment Variables
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/secure-banking-db

# JWT Secrets (change these to long random strings in production!)
JWT_SECRET=your_super_secret_jwt_key_change_me_in_prod
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_me_in_prod

# Token Expiry
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin seed (first user with this email is auto-promoted to admin)
ADMIN_EMAIL=admin@bank.com
